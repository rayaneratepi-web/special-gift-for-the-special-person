<!DOCTYPE html>
<html lang="en" data-theme="midnight">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>A living garden grew for you - TATA Meriem</title>
<meta name="description" content="A special garden built with love for TATA Meriem.">
<meta name="theme-color" content="#050914">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
/* ================= CONFIG/TOKENS ================= */
:root {
  --ease-out: cubic-bezier(.22, 1, .36, 1);
  --ease-spring: cubic-bezier(.34, 1.45, .4, 1);
  --serif: "Cormorant Garamond", "Playfair Display", Georgia, serif;
  --sans: "Inter", system-ui, -apple-system, sans-serif;
  --bg0: #040711; --bg1: #09122a; --bg2: #121e42;
  --ink: #f8edd9; --ink-dim: rgba(248, 237, 217, 0.72); --ink-faint: rgba(248, 237, 217, 0.42);
  --accent: #f0be72; --accent2: #ff8aa1;
  --veil: radial-gradient(ellipse 75% 55% at 50% 48%, rgba(4, 7, 17, 0.76), rgba(4, 7, 17, 0.32) 55%, transparent 75%);
  --grain-op: .06; --particle: #ffd9a0; --glow: rgba(240, 190, 114, 0.4);
  --panel: #0d152c; --line: rgba(248, 237, 217, 0.16);
  --card-bg: rgba(11, 19, 41, 0.85); --card-border: rgba(240, 190, 114, 0.3);
  --card-shadow: 0 24px 64px rgba(0,0,0,0.55), 0 0 45px rgba(240, 190, 114, 0.14);
  --hz: rgba(240, 158, 82, 0.55);
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { height: 100%; width: 100%; margin: 0; padding: 0; background: var(--bg0); color: var(--ink); font-family: var(--sans); overflow: hidden; }

/* ================= PAGE 1: WHITE PLAYFUL INTRO ================= */
#whiteIntro {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  transition: opacity 1s ease, visibility 1s ease;
}
#whiteIntro.hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.white-card {
  position: relative;
  width: 90%;
  max-width: 440px;
  min-height: 280px;
  background: #ffffff;
  border: 2px solid #f0be72;
  border-radius: 24px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.08), 0 0 25px rgba(240, 190, 114, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 24px;
  text-align: center;
  overflow: hidden;
}
.white-card h2 {
  font-family: var(--serif);
  font-size: clamp(28px, 6vw, 38px);
  color: #2c3e50;
  margin: 0 0 30px;
  font-weight: 600;
}
.play-btn {
  position: relative;
  padding: 14px 28px;
  font-size: 15px;
  font-weight: 600;
  color: #111;
  background: linear-gradient(135deg, #f0be72, #ff8aa1);
  border: none;
  border-radius: 99px;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(240, 190, 114, 0.4);
  transition: transform 0.25s var(--ease-spring), background 0.3s ease;
  user-select: none;
}
.play-btn:active {
  transform: scale(0.95);
}

/* ================= STAGE & GARDEN STYLING ================= */
#stage {
  position: fixed; inset: 0; height: 100dvh; width: 100vw; overflow: hidden;
  background: radial-gradient(120% 90% at 50% 110%, var(--bg2), transparent 60%),
              radial-gradient(140% 100% at 50% -10%, var(--bg2), transparent 55%),
              linear-gradient(var(--bg1), var(--bg0));
}
#camera {
  position: absolute; inset: 0; width: 100%; height: 100%;
  transform: scale(1.55); transform-origin: 50% 50%;
  will-change: transform;
}
#horizon {
  position: absolute; left: -15%; right: -15%; top: 26%; height: 60%;
  pointer-events: none; opacity: 0; transition: opacity 3.5s ease;
  background: radial-gradient(68% 85% at 50% 32%, var(--hz), transparent 72%);
  filter: blur(12px);
}
#horizon.on { opacity: 1; }
#sky {
  position: absolute; inset: -8%; pointer-events: none;
  background: radial-gradient(65% 45% at 68% 20%, var(--glow), transparent 72%);
  animation: skyDrift 28s ease-in-out infinite alternate;
}
@keyframes skyDrift { from { transform: translate3d(-1.5%, 1%, 0); } to { transform: translate3d(1.5%, -1%, 0); } }
#garden { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
#garden g { will-change: transform, opacity; }
#veil { position: absolute; inset: 0; background: var(--veil); opacity: 0; transition: opacity 2.4s ease; pointer-events: none; }
#veil.on { opacity: 1; }
#vignette { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(120% 100% at 50% 45%, transparent 56%, rgba(0,0,0,.44) 100%); }
#grain { position: absolute; inset: -40px; pointer-events: none; opacity: var(--grain-op); mix-blend-mode: overlay; }
#dust { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

/* SVG Animation utilities */
.breathe { animation: breathe var(--bd, 6s) ease-in-out infinite; animation-delay: var(--bdel, 0s); transform-box: fill-box; transform-origin: center; }
@keyframes breathe { 0%,100% { transform: scale(1) rotate(var(--br, 0deg)); } 50% { transform: scale(1.038) rotate(var(--br,0deg)); } }
.sway { animation: sway var(--sd, 7.5s) ease-in-out infinite; animation-delay: var(--sdel, 0s); transform-box: fill-box; transform-origin: bottom center; }
@keyframes sway { 0%, 100% { transform: rotate(-1.8deg); } 50% { transform: rotate(1.8deg); } }
.leafSway { animation: leafSway var(--ld,5.2s) ease-in-out infinite; animation-delay: var(--ldel,0s); transform-box: fill-box; transform-origin: 0% 50%; }
@keyframes leafSway { 0%, 100% { transform: rotate(-5deg); } 50% { transform: rotate(6deg); } }
.flower-hit { cursor: pointer; pointer-events: all; }

/* ================= PAGE 2 INTRO OVERLAY ================= */
#intro {
  position: absolute; inset: 0; z-index: 30; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center;
  padding: 0 24px calc(30px + env(safe-area-inset-bottom)); cursor: pointer;
  transition: opacity 1s ease, visibility 1s;
}
#intro.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
#budWrap { width: 130px; height: 180px; margin-bottom: 10px; animation: budBreathe 4.5s ease-in-out infinite; filter: drop-shadow(0 0 32px var(--glow)); }
@keyframes budBreathe { 0%, 100% { transform: scale(1) translateY(0); } 50% { transform: scale(1.05) translateY(-4px); } }
.kicker { font-size: 11.5px; letter-spacing: .42em; text-transform: uppercase; color: var(--ink-faint); margin: 0 0 12px; font-weight: 500; }
#introName { font-family: var(--serif); font-weight: 500; font-size: clamp(34px, 7vw, 62px); line-height: 1.05; margin: 0; text-shadow: 0 2px 25px var(--glow); }
#introName em { color: var(--accent); font-style: italic; font-weight: 600; }
#introSub { font-family: var(--serif); font-style: italic; font-size: clamp(19px, 4vw, 24px); color: var(--ink-dim); margin: 14px 0 0; }
#tapHint {
  margin-top: 36px; font-size: 11.5px; letter-spacing: .3em; text-transform: uppercase;
  color: var(--ink); border: 1px solid var(--line); border-radius: 999px;
  padding: 13px 28px; background: rgba(255,255,255,.05); animation: hintPulse 2.6s ease-in-out infinite;
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); cursor: pointer;
  box-shadow: 0 8px 24px rgba(0,0,0,.25); transition: transform .2s ease, border-color .2s ease;
}
#tapHint:hover { transform: scale(1.04); border-color: var(--accent); }
@keyframes hintPulse { 0%, 100% { opacity: .75; transform: scale(1); } 50% { opacity: 1; transform: scale(1.025); } }

/* ================= SHORT CARD & FULL DEEP LETTER MODALS ================= */
#message {
  position: absolute; inset: 0; z-index: 22; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center;
  padding: 20px 24px calc(70px + env(safe-area-inset-bottom));
  pointer-events: none; opacity: 0; transition: opacity .8s ease;
}
#message.on { opacity: 1; pointer-events: auto; }
#letterCard {
  position: relative; width: 100%; max-width: 500px;
  padding: clamp(26px, 5.5vw, 42px) clamp(22px, 5vw, 38px);
  background: var(--card-bg); border: 1px solid var(--card-border);
  border-radius: 26px; box-shadow: var(--card-shadow);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  opacity: 0; transform: translateY(24px) scale(0.96);
  transition: opacity 1.2s ease, transform 1.2s var(--ease-out);
  pointer-events: auto;
}
#letterCard.shown { opacity: 1; transform: translateY(0) scale(1); }
#letterCard.card-minimized { opacity: 0 !important; transform: translateY(35px) scale(0.92) !important; pointer-events: none !important; }

.card-ornament { font-size: 13px; letter-spacing: .38em; color: var(--accent); opacity: .85; margin-bottom: 14px; }
#mOccasion { font-size: 11px; letter-spacing: .42em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; font-weight: 500; }
#mName { font-family: var(--serif); font-weight: 600; font-size: clamp(34px, 7.5vw, 52px); line-height: 1.06; margin: 0 0 6px; text-shadow: 0 2px 30px var(--glow); }
#mRule { width: 46px; height: 1.5px; background: var(--accent); opacity: .8; margin: 16px auto 18px; border-radius: 2px; }
#mBody { font-family: var(--serif); font-style: italic; font-weight: 500; font-size: clamp(19px, 4.2vw, 24px); line-height: 1.58; color: var(--ink); margin: 0 auto; max-width: 34ch; }
#mBody p { margin: .4em 0; }
#mFrom { font-family: var(--serif); font-size: clamp(18px, 3.8vw, 21px); color: var(--ink-dim); margin-top: 20px; font-style: normal; }

.continue-btn {
  margin-top: 22px; padding: 10px 24px; font-size: 13px; letter-spacing: .15em; text-transform: uppercase;
  color: #111; background: var(--accent); border: none; border-radius: 999px; font-weight: 600; cursor: pointer;
  box-shadow: 0 4px 16px rgba(240, 190, 114, 0.4); transition: transform 0.2s ease, filter 0.2s ease;
}
.continue-btn:hover { transform: translateY(-2px); filter: brightness(1.1); }

/* PAGE 3: FULL DEEP HEARTFELT LETTER MODAL */
#fullLetterModal {
  position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column;
  align-items: center; justify-content: center; padding: 20px 20px calc(40px + env(safe-area-inset-bottom));
  background: rgba(4, 7, 17, 0.75); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
  opacity: 0; visibility: hidden; transition: opacity 0.6s ease, visibility 0.6s ease;
}
#fullLetterModal.on { opacity: 1; visibility: visible; }
.full-letter-card {
  position: relative; width: 100%; max-width: 580px; max-height: 80vh; overflow-y: auto;
  padding: clamp(26px, 5vw, 42px); background: var(--card-bg); border: 1px solid var(--card-border);
  border-radius: 28px; box-shadow: var(--card-shadow); color: var(--ink); text-align: left;
}
.full-letter-card p {
  font-family: var(--serif); font-size: clamp(18px, 3.8vw, 22px); line-height: 1.6; margin-bottom: 18px; color: var(--ink);
}
.full-letter-card .closing {
  font-family: var(--serif); font-weight: 600; font-size: clamp(20px, 4vw, 24px); color: var(--accent); margin-top: 24px;
}
.modal-actions {
  display: flex; justify-content: center; gap: 12px; margin-top: 24px; flex-wrap: wrap;
}

/* ================= TOAST & BOTTOM CONTROLS ================= */
#toast {
  position: absolute; left: 50%; bottom: calc(92px + env(safe-area-inset-bottom));
  transform: translateX(-50%) translateY(8px); z-index: 40;
  font-family: var(--serif); font-style: italic; font-size: 19px; color: var(--ink);
  background: rgba(13, 21, 44, 0.9); border: 1px solid var(--accent); padding: 12px 24px; border-radius: 999px;
  opacity: 0; transition: opacity .45s ease, transform .45s var(--ease-out);
  pointer-events: none; white-space: nowrap; max-width: 92vw; overflow: hidden; text-overflow: ellipsis;
  box-shadow: 0 14px 36px rgba(0,0,0,.45), 0 0 24px var(--glow);
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
}
#toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

#chrome {
  position: absolute; inset: auto 0 0 0; z-index: 35; display: flex;
  justify-content: center; align-items: flex-end;
  padding: 0 18px calc(16px + env(safe-area-inset-bottom));
  opacity: 0; transition: opacity 1.5s ease; pointer-events: none;
}
#chrome.on { opacity: 1; pointer-events: auto; }
.chip-group { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.chip {
  pointer-events: auto; font-family: var(--sans); font-size: 11px;
  letter-spacing: .2em; text-transform: uppercase; color: var(--ink-dim);
  background: rgba(13, 21, 44, 0.75); border: 1px solid var(--line); border-radius: 999px; padding: 10px 17px;
  cursor: pointer; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  transition: all .25s ease; display: flex; align-items: center; gap: 7px;
  box-shadow: 0 6px 20px rgba(0,0,0,.22);
}
.chip:hover { color: var(--ink); border-color: var(--accent); transform: translateY(-2px); }
.chip:active { transform: scale(.97); }

@media (max-width: 600px) {
  #chrome { padding: 0 12px calc(12px + env(safe-area-inset-bottom)); }
  .chip { padding: 8px 13px; font-size: 10.5px; }
}
</style>
</head>
<body>

<!-- PAGE 1: PLAYFUL WHITE INTRO SCREEN -->
<div id="whiteIntro">
  <div class="white-card">
    <h2>Welcome to your own space</h2>
    <button class="play-btn" id="playStartBtn">Press to start</button>
  </div>
</div>

<div id="stage" aria-label="A dense blooming meadow">
  <div id="camera">
    <div id="sky"></div>
    <div id="horizon"></div>
    <svg id="garden" viewBox="0 0 1000 800" preserveAspectRatio="xMidYMax slice" role="img" aria-label="Lush blooming floral meadow">
      <defs id="shared-defs"></defs>
    </svg>
    <canvas id="dust" aria-hidden="true"></canvas>
  </div>
  <div id="veil"></div>
  <div id="vignette"></div>
  <svg id="grain" aria-hidden="true"></svg>

  <!-- SHORT LETTER CARD CONTAINER -->
  <div id="message" aria-live="polite">
    <div id="letterCard">
      <div class="card-ornament">✦ 🌹 ✦</div>
      <div id="mOccasion">just for you</div>
      <h1 id="mName">TATA Meriem</h1>
      <div id="mRule"></div>
      <div id="mBody">
        <p>I couldn't give you flowers</p>
        <p>that last forever,</p>
        <p>so I grew you a meadow</p>
        <p>that never wilts.</p>
      </div>
      <div id="mFrom">- Rayane</div>
      <button class="continue-btn" id="continueBtn">Continue Reading</button>
    </div>
  </div>

  <!-- PAGE 2: INTRO SCREEN -->
  <div id="intro" role="button" tabindex="0" aria-label="Tap to open your letter and grow the garden">
    <div id="budWrap" aria-hidden="true"></div>
    <div class="kicker">A LIVING LETTER</div>
    <h1 id="introName">For <em>the gorgeous woman ever</em></h1>
    <p id="introSub">A little gift to you TATA</p>
    <button id="tapHint" aria-label="Tap to open">touch to bloom</button>
  </div>

  <!-- TOAST WHISPER -->
  <div id="toast" role="status"></div>

  <!-- FLOATING CONTROL BAR (ONLY SOUND, HIDE CARD, REPLAY) -->
  <div id="chrome">
    <div class="chip-group">
      <button class="chip" id="soundBtn" aria-label="Toggle sound"><span>♫</span> <span id="soundLabel">Sound On</span></button>
      <button class="chip" id="cardToggleBtn" aria-label="Toggle letter card visibility"><span>👁</span> <span id="cardToggleLabel">Hide Card</span></button>
      <button class="chip" id="replayBtn" aria-label="Replay the bloom"><span>↻</span> Replay</button>
    </div>
  </div>
</div>

<!-- PAGE 3: FULL DEEP HEARTFELT LETTER MODAL -->
<div id="fullLetterModal">
  <div class="full-letter-card">
    <p>Dear khalti Meriem the gorgeous and strongest woman I knew, this little space is built just and only for you to bring a smile to your face. You are held in such high regard and loved so deeply, storms don’t last forever but the strength inside you does, you don’t have to carry it alone, and know that you have an entire circle of people standing right beside you,</p>
    <p>You can always count on me as your own son. If you ever need anything please dont hesitate to ask me. I’ll be right here whenever you need me</p>
    <p>Keep smiling, keep fighting, have faith.</p>
    <p>Always in my toughts and prayers wishing you a full and speedy recovery</p>
    <div class="closing">With deepest respect and support,<br>Rayane.</div>
    <div class="modal-actions">
      <button class="chip" id="modalHideBtn"><span>👁</span> Hide Letter</button>
      <button class="chip" id="modalReplayBtn"><span>↻</span> Replay</button>
    </div>
  </div>
</div>

<script>
"use strict";

/* ================= PAGE 1 PLAYFUL BUTTON LOGIC ================= */
let playClickCount = 0;
const playBtn = document.getElementById("playStartBtn");
const whiteIntro = document.getElementById("whiteIntro");

playBtn.addEventListener("click", (e) => {
  e.stopPropagation();
  playClickCount++;

  if (playClickCount === 1) {
    playBtn.style.transform = "translate(70px, -45px)";
  } else if (playClickCount === 2) {
    playBtn.style.transform = "translate(-80px, 50px)";
    playBtn.textContent = "Try harder you’re stronger than that";
  } else if (playClickCount === 3) {
    playBtn.style.transform = "translate(50px, 60px)";
    playBtn.textContent = "its the last time I swear 😂";
  } else if (playClickCount >= 4) {
    whiteIntro.classList.add("hidden");
  }
});

/* ================= CUSTOM WHISPERS ================= */
const WHISPERS = [
  "keep fighting TATA, you’ve got this",
  "Every single day you teach us what true courage looks like",
  "and pls remember you’re not alone in this",
  "always in our thoughts and prayers",
  "a meadow of strength blooming just for you"
];

/* ================= WEB AUDIO SYNTHESIZER ================= */
let audioCtx = null, soundMuted = false;
function initAudio() {
  if (audioCtx) return;
  try {
    const AC = window.AudioContext || window.webkitAudioContext;
    if (AC) audioCtx = new AC();
  } catch(e){}
}
function playTone(freq, type="sine", startDelay=0, dur=0.6, vol=0.08) {
  if (soundMuted || !audioCtx) return;
  if (audioCtx.state === "suspended") audioCtx.resume();
  const now = audioCtx.currentTime + startDelay;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(freq, now);
  gain.gain.setValueAtTime(0.0001, now);
  gain.gain.exponentialRampToValueAtTime(vol, now + 0.04);
  gain.gain.exponentialRampToValueAtTime(0.0001, now + dur);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start(now);
  osc.stop(now + dur + 0.05);
}
const CHORDS = [
  [329.63, 392.00, 493.88, 587.33, 659.25],
  [261.63, 329.63, 392.00, 523.25, 659.25],
  [293.66, 369.99, 440.00, 587.33, 739.99]
];
function playBloomChime() {
  const chord = CHORDS[Math.floor(Math.random() * CHORDS.length)];
  chord.forEach((f, i) => { playTone(f * 1.5, "sine", i * 0.12, 1.4, 0.05); });
}
function playFlowerTapChime(kind) {
  if (kind === "rose") {
    [440, 554.37, 659.25, 880].forEach((f, i) => { playTone(f, "sine", i * 0.08, 0.85, 0.07); });
    return;
  }
  const bases = { tulip: 523.25, sun: 392, daisy: 587.33, lavender: 659.25, hero: 329.63 };
  const base = bases[kind] || 440;
  playTone(base * 1.25, "sine", 0, 0.7, 0.07);
}

/* ================= PALETTE & GENERATION ================= */
const PAL = {
  stem: "#2c4c36",
  leaf: ["#3d6a4c","#274f35","#528261"],
  glow: "#ffd9a0",
  hero: { deep: "#8e1837", mid: "#db486d", light: "#ffaec0", tip: "#ffedf2", core: "#55071c", stamen: "#ffe2a3" },
  rose: { deep: "#991b3b", mid: "#e54b70", light: "#ffb5c6", core: "#5c081e" },
  tulip: { base: "#c9364b", mid: "#f56e82", tip: "#ffccd6" },
  sun: { base: "#d4801e", tip: "#ffd852", disc: "#42240b", seed: "#241203", dot: "#9e6b2c" },
  daisy: { petal: "#fff6e8", petalShade: "#fedcb8", center: "#f2a92b" },
  lavender: { flower: "#9973e6", shade: "#6b45be", tip: "#d6c4ff" }
};

const NS = "http://www.w3.org/2000/svg";
const svgEl = (t, attrs={}, parent) => {
  const e = document.createElementNS(NS, t);
  for (const k in attrs) e.setAttribute(k, attrs[k]);
  if (parent) parent.appendChild(e);
  return e;
};
const garden = document.getElementById("garden");

function initSharedDefs() {
  const defs = garden.querySelector("#shared-defs") || svgEl("defs", {id:"shared-defs"}, garden);
  defs.innerHTML = `
    <linearGradient id="roseGrad" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="${PAL.rose.deep}"/>
      <stop offset="60%" stop-color="${PAL.rose.mid}"/>
      <stop offset="100%" stop-color="${PAL.rose.light}"/>
    </linearGradient>
    <linearGradient id="tulipGrad" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="${PAL.tulip.base}"/>
      <stop offset="50%" stop-color="${PAL.tulip.mid}"/>
      <stop offset="100%" stop-color="${PAL.tulip.tip}"/>
    </linearGradient>
    <linearGradient id="heroPetalGrad" x1="0" y1="1" x2="0" y2="0">
      <stop offset="0%" stop-color="${PAL.hero.deep}"/>
      <stop offset="55%" stop-color="${PAL.hero.mid}"/>
      <stop offset="86%" stop-color="${PAL.hero.light}"/>
      <stop offset="100%" stop-color="${PAL.hero.tip}"/>
    </linearGradient>
    <radialGradient id="heroCoreGrad" cx="50%" cy="50%" r="55%">
      <stop offset="0%" stop-color="${PAL.hero.core}"/>
      <stop offset="70%" stop-color="${PAL.hero.deep}"/>
      <stop offset="100%" stop-color="${PAL.hero.mid}"/>
    </radialGradient>
  `;
}

function petalPath(len, wid, curl=0) {
  return `M0,0 C${-wid},${-len*.35} ${-wid*.85+curl},${-len*.85} ${curl},${-len} C${wid*.85+curl},${-len*.85} ${wid},${-len*.35} 0,0 Z`;
}
function leafPath(len, wid) {
  return `M0,0 C${wid},${-len*.32} ${wid*.8},${-len*.82} 0,${-len} C${-wid*.8},${-len*.82} ${-wid},${-len*.32} 0,0 Z`;
}
function tulipPetalPath(len, wid, curve=0) {
  return `M0,0 C${-wid*1.1},${-len*.28} ${-wid*.9+curve},${-len*.78} ${curve},${-len} C${wid*.9+curve},${-len*.78} ${wid*1.1},${-len*.28} 0,0 Z`;
}
function rosePetalPath(len, wid, round=1) {
  return `M0,0 C${-wid*1.15},${-len*.25} ${-wid*1.2},${-len*.75} 0,${-len*round} C${wid*1.2},${-len*.75} ${wid*1.15},${-len*.25} 0,0 Z`;
}

/* ================= INTRO BUD PREVIEW ================= */
(function introBud(){
