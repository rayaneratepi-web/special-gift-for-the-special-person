/* ================= FLOWER RECEPTACLES & STEM GROWER ================= */
const allFlowers = [];
function stemGrow(parent, x0, y0, x1, y1, bend, leafN, detail) {
  const g = svgEl("g", {class:"sway", style:`--sd:${(6.2+Math.random()*3).toFixed(2)}s;--sdel:${(-Math.random()*8).toFixed(2)}s`}, parent);
  const mx = (x0 + x1)/2 + bend, my = (y0 + y1)/2;
  const d = `M${x0},${y0} Q${mx.toFixed(1)},${my.toFixed(1)} ${x1},${y1}`;
  const path = svgEl("path", {d, fill:"none", stroke:PAL.stem, "stroke-width": detail>1?3.2:2.2, "stroke-linecap":"round"}, g);
  const len = path.getTotalLength();
  path.style.strokeDasharray = len;
  path.style.strokeDashoffset = len;
  return {group:g, path, len, tip:{x:x1, y:y1}};
}
function growPath(path, len, dur) {
  return new Promise(res => {
    path.style.transition = `stroke-dashoffset ${dur}ms cubic-bezier(.35,0,.25,1)`;
    path.style.strokeDashoffset = 0;
    setTimeout(res, dur+25);
  });
}
function bloomRing(petals, baseDelay, dur, step=20) {
  return new Promise(res => {
    if (!petals.length) { res(); return; }
    let done = 0;
    petals.forEach((p, i) => {
      const a = p.el.animate(
        [{transform:p.from, opacity:0}, {transform:p.to, opacity:(p.op==null?1:p.op)}],
        {duration:dur, delay: Math.max(0, baseDelay + i*step), easing:"cubic-bezier(.34,1.4,.4,1)", fill:"forwards"}
      );
      a.onfinish = () => { if (++done === petals.length) res(); };
    });
  });
}

/* 1. HERO BLOOM (Peony) */
function createTopViewBloom(parent, cx, cy, Rr) {
  const g = svgEl("g", {transform:`translate(${cx},${cy})`}, parent);
  const live = svgEl("g", {class:"breathe", style:`--bd:6.5s;--bdel:0s`}, g);
  const ringSpec = [5, 8, 12, 16, 20];
  const rings = [];
  for (let L = ringSpec.length-1; L >= 0; L--) {
    const n = ringSpec[L], frac = .32 + .68 * (L/(ringSpec.length-1)||1);
    const ring = [];
    for (let i = 0; i < n; i++) {
      const a = (360/n)*i + L*11;
      const holder = svgEl("g", {transform:`rotate(${a.toFixed(1)})`}, live);
      const plen = Rr*frac, pw = plen*.45;
      const p = svgEl("path", {d:petalPath(plen, pw), fill:"url(#heroPetalGrad)", opacity:0}, holder);
      p.style.transformBox = "fill-box"; p.style.transformOrigin = "50% 100%";
      ring.push({el:p, from:`translate(0px, 10px) scale(.38)`, to:`translate(0px, 0px) scale(1)`, op:.95});
    }
    rings[L] = ring;
  }
  const budHint = svgEl("circle", {r:(Rr*.14).toFixed(1), fill:PAL.hero.deep, opacity:.94}, live);
  const core = svgEl("circle", {r:(Rr*.16).toFixed(1), fill:"url(#heroCoreGrad)", opacity:0}, live);
  const rec = {group:g, live, rings, core, budHint, cx, cy, r:Rr, kind:"hero", pulse:live, layerRank:2,
    async bloom() {
      budHint.animate([{opacity:.94}, {opacity:0}], {duration:380, fill:"forwards"});
      for (let L = 0; L < rings.length; L++) await bloomRing(rings[L], L==0?120:360, 680, 24);
      core.animate([{opacity:0}, {opacity:1}], {duration:550, fill:"forwards"});
    },
    setOpen() {
      budHint.setAttribute("opacity", 0);
      rings.forEach(ring => ring.forEach(p => { p.el.style.transform=p.to; p.el.style.opacity=p.op; }));
      core.setAttribute("opacity", 1);
    }
  };
  return rec;
}

/* 2. ROSE */
function createRose(layer, x0, y0, x1, y1, o={}) {
  const r = o.r || 24, wrap = svgEl("g", {opacity:0}, layer);
  const st = stemGrow(wrap, x0, y0, x1, y1, o.bend||0, 2, 2);
  const hg = svgEl("g", {transform:`translate(${x1},${y1})`, opacity:0}, wrap);
  const live = svgEl("g", {class:"breathe", style:`--bd:6s;--bdel:0s`}, hg);
  const petals = [];
  [{n:3, len:.55, wid:.45}, {n:4, len:.75, wid:.52}, {n:5, len:.95, wid:.58}].forEach((lvl, li) => {
    for (let i = 0; i < lvl.n; i++) {
      const a = (360/lvl.n)*i + li*34;
      const holder = svgEl("g", {transform:`rotate(${a.toFixed(1)})`}, live);
      const plen = r*lvl.len;
      const p = svgEl("path", {d:rosePetalPath(plen, plen*lvl.wid), fill:"url(#roseGrad)", opacity:0}, holder);
      p.style.transformBox = "fill-box"; p.style.transformOrigin = "50% 100%";
      petals.push({el:p, from:`scale(.25)`, to:`scale(1)`, op:.95});
    }
  });
  const core = svgEl("ellipse", {cx:0, cy:0, rx:(r*.22).toFixed(1), ry:(r*.28).toFixed(1), fill:PAL.rose.core, opacity:0}, live);
  const hit = svgEl("circle", {cx:x1, cy:y1, r:Math.max(26, r+14), fill:"transparent", class:"flower-hit"}, wrap);
  const rec = {wrap, stem:st, hg, live, petals, core, x:x1, y:y1, r, kind:"rose", pulse:live, layerRank:o.layerRank||1,
    grow(dur) { this.wrap.setAttribute("opacity", 1); return growPath(this.stem.path, this.stem.len, dur); },
    async bloomHead() {
      this.hg.setAttribute("opacity", 1);
      this.core.animate([{opacity:0}, {opacity:1}], {duration:500, fill:"forwards"});
      await bloomRing(this.petals, 0, 680, 26);
    },
    setOpen() {
      this.wrap.setAttribute("opacity", 1); this.stem.path.style.strokeDashoffset = 0;
      this.hg.setAttribute("opacity", 1); this.core.setAttribute("opacity", 1);
      this.petals.forEach(p => { p.el.style.transform=p.to; p.el.style.opacity=p.op; });
    }
  };
  hit.addEventListener("pointerdown", ev => { ev.stopPropagation(); tapFlower(rec); });
  allFlowers.push(rec);
  return rec;
}

/* 3. TULIP */
function createTulip(layer, x0, y0, x1, y1, o={}) {
  const r = o.r || 22, wrap = svgEl("g", {opacity:0}, layer);
  const st = stemGrow(wrap, x0, y0, x1, y1, o.bend||0, 2, 2);
  const hg = svgEl("g", {transform:`translate(${x1},${y1})`, opacity:0}, wrap);
  const live = svgEl("g", {class:"breathe", style:`--bd:6s;--bdel:0s`}, hg);
  const petals = [];
  [{rot:-14, op:.9}, {rot:14, op:.9}, {rot:0, op:1}].forEach(s => {
    const holder = svgEl("g", {transform:`rotate(${s.rot}deg)`}, live);
    const p = svgEl("path", {d:tulipPetalPath(r*1.15, r*.38), fill:"url(#tulipGrad)", opacity:0}, holder);
    p.style.transformBox = "fill-box"; p.style.transformOrigin = "50% 100%";
    petals.push({el:p, from:`scale(.3) translateY(12px)`, to:`scale(1) translateY(0px)`, op:s.op});
  });
  const hit = svgEl("circle", {cx:x1, cy:y1, r:Math.max(24, r+12), fill:"transparent", class:"flower-hit"}, wrap);
  const rec = {wrap, stem:st, hg, live, petals, x:x1, y:y1, r, kind:"tulip", pulse:live, layerRank:o.layerRank||1,
    grow(dur) { this.wrap.setAttribute("opacity", 1); return growPath(this.stem.path, this.stem.len, dur); },
    async bloomHead() { this.hg.setAttribute("opacity", 1); await bloomRing(this.petals, 0, 600, 30); },
    setOpen() {
      this.wrap.setAttribute("opacity", 1); this.stem.path.style.strokeDashoffset = 0;
      this.hg.setAttribute("opacity", 1);
      this.petals.forEach(p => { p.el.style.transform=p.to; p.el.style.opacity=p.op; });
    }
  };
  hit.addEventListener("pointerdown", ev => { ev.stopPropagation(); tapFlower(rec); });
  allFlowers.push(rec);
  return rec;
}

/* ================= BUILD MEADOW LAYER ================= */
const layers = {};
["back","mid","hero","front"].forEach(n => { layers[n] = svgEl("g", {id:"layer-"+n}, garden); });
let VR = {x:0, y:0, w:1000, h:800};

function computeVRect() {
  const vw = Math.max(320, window.innerWidth || 1000);
  const vh = Math.max(480, window.innerHeight || 800);
  let baseW = Math.round(800 * (vw/vh));
  baseW = Math.max(440, Math.min(1440, baseW));
  garden.setAttribute("viewBox", `0 0 ${baseW} 800`);
  VR = {x:0, y:0, w:baseW, h:800};
  return VR;
}

let hero = null, heroTap = null;
function buildGarden() {
  computeVRect();
  initSharedDefs();
  garden.querySelectorAll("#layer-back,#layer-mid,#layer-hero,#layer-front").forEach(g => { g.innerHTML=""; });
  allFlowers.length = 0;

  const X = f => f * VR.w, Y = f => f * VR.h;
  const Y0 = () => VR.h + 100;
  const hx = X(0.5), hy = Y(0.58), HR = Math.min(VR.w * 0.22, 142);

  // Background & Midground Flowers
  for (let i = 0; i < 16; i++) {
    const fx = (i + 0.5) / 16;
    createTulip(layers.back, X(fx), Y0(), X(fx), Y(0.45), {r:18, layerRank:0});
  }
  for (let i = 0; i < 14; i++) {
    const fx = (i + 0.3) / 14;
    createRose(layers.mid, X(fx), Y0(), X(fx), Y(0.65), {r:24, layerRank:1});
  }

  // Hero Bloom
  hero = createTopViewBloom(layers.hero, hx, hy, HR);
  const hhit = svgEl("circle", {cx:hx, cy:hy, r:HR, fill:"transparent", class:"flower-hit"}, layers.hero);
  heroTap = {pulse:hero.live, x:hx, y:hy, kind:"hero"};
  hhit.addEventListener("pointerdown", ev => { ev.stopPropagation(); tapFlower(heroTap); });

  // Companion Roses
  createRose(layers.hero, hx - HR*0.75, Y0(), hx - HR*0.72, hy + HR*0.35, {r:32, layerRank:2});
  createRose(layers.hero, hx + HR*0.75, Y0(), hx + HR*0.72, hy + HR*0.35, {r:32, layerRank:2});

  // Foreground Flowers
  const fgSpots = [[0.05, 0.78], [0.25, 0.82], [0.75, 0.82], [0.95, 0.78]];
  fgSpots.forEach(([fx, fy]) => {
    createRose(layers.front, X(fx), Y0(), X(fx), Y(fy), {r:38, layerRank:3});
  });
}

/* ================= ANIMATION & BLOOM SEQUENCE ================= */
let played = false;
const cam = document.getElementById("camera"), veil = document.getElementById("veil");

function setCam(s, dur) {
  cam.style.transition = dur ? `transform ${dur}ms cubic-bezier(.22,1,.36,1)` : "none";
  cam.style.transform = `scale(${s})`;
}

async function playSequence() {
  if (played) return; played = true;
  initAudio();
  document.getElementById("intro").classList.add("hidden");
  document.getElementById("horizon").classList.add("on");
  setCam(1.55, 0);

  playBloomChime();
  const blooming = hero.bloom();
  await blooming;
  setCam(0.95, 3200);

  const wave = [...allFlowers].sort((a,b) => a.layerRank - b.layerRank);
  await Promise.all(wave.map((f, i) => (async() => {
    await new Promise(r => setTimeout(r, i * 120));
    await f.grow(600);
    f.bloomHead();
  })()));

  setCam(0.92, 2200);
  setTimeout(revealMessage, 600);
}

function revealMessage() {
  veil.classList.add("on");
  document.getElementById("message").classList.add("on");
  document.getElementById("letterCard").classList.add("shown");
  document.getElementById("chrome").classList.add("on");
  startDust();
}

/* ================= TAP FLOWERS & TOAST WHISPERS ================= */
const toast = document.getElementById("toast");
let toastT = null;
function whisper(t) {
  toast.textContent = t; toast.classList.add("show");
  clearTimeout(toastT); toastT = setTimeout(() => toast.classList.remove("show"), 3200);
}
function tapFlower(rec) {
  if (!played || !rec || !rec.pulse) return;
  rec.pulse.style.transition = "transform .38s cubic-bezier(.2,.9,.3,1.4)";
  rec.pulse.style.transform = "scale(1.2)";
  setTimeout(() => { rec.pulse.style.transform = ""; }, 380);
  playFlowerTapChime(rec.kind);
  whisper(WHISPERS[Math.floor(Math.random() * WHISPERS.length)]);
}

/* ================= PARTICLES ================= */
const dust = document.getElementById("dust"), dctx = dust.getContext("2d");
let fireflies = [];
function sizeDust() { dust.width = window.innerWidth; dust.height = window.innerHeight; }
window.addEventListener("resize", sizeDust); sizeDust();
function startDust() {
  for (let i = 0; i < 45; i++) {
    fireflies.push({
      x: Math.random()*dust.width, y: Math.random()*dust.height,
      r: Math.random()*2 + 0.8, speedY: Math.random()*0.3 + 0.1, phase: Math.random()*6.28
    });
  }
  requestAnimationFrame(loopDust);
}
function loopDust() {
  dctx.clearRect(0, 0, dust.width, dust.height);
  dctx.fillStyle = "#ffd9a0";
  fireflies.forEach(p => {
    p.y -= p.speedY; p.phase += 0.02;
    if (p.y < -10) p.y = dust.height + 10;
    dctx.globalAlpha = 0.4 + 0.3 * Math.sin(p.phase);
    dctx.beginPath(); dctx.arc(p.x, p.y, p.r, 0, 6.28); dctx.fill();
  });
  requestAnimationFrame(loopDust);
}

/* ================= BUTTON INTERACTION EVENTS ================= */
let cardHidden = false;
const cardToggleBtn = document.getElementById("cardToggleBtn");
const cardToggleLabel = document.getElementById("cardToggleLabel");
const letterCard = document.getElementById("letterCard");

cardToggleBtn.onclick = (e) => {
  e.stopPropagation();
  cardHidden = !cardHidden;
  if (cardHidden) {
    letterCard.classList.add("card-minimized");
    cardToggleLabel.textContent = "Show Card";
  } else {
    letterCard.classList.remove("card-minimized");
    cardToggleLabel.textContent = "Hide Card";
  }
};

const soundBtn = document.getElementById("soundBtn");
const soundLabel = document.getElementById("soundLabel");
soundBtn.onclick = (e) => {
  e.stopPropagation();
  initAudio();
  soundMuted = !soundMuted;
  soundLabel.textContent = soundMuted ? "Sound Off" : "Sound On";
  soundBtn.style.opacity = soundMuted ? "0.6" : "1";
};

document.getElementById("replayBtn").onclick = (e) => { e.stopPropagation(); location.reload(); };

/* Full Deep Letter Modal Triggers */
const fullLetterModal = document.getElementById("fullLetterModal");
document.getElementById("continueBtn").onclick = (e) => {
  e.stopPropagation();
  fullLetterModal.classList.add("on");
};
document.getElementById("modalHideBtn").onclick = (e) => {
  e.stopPropagation();
  fullLetterModal.classList.remove("on");
};
document.getElementById("modalReplayBtn").onclick = (e) => {
  e.stopPropagation();
  location.reload();
};

/* Start blooming on intro tap */
const intro = document.getElementById("intro");
intro.addEventListener("click", playSequence);
intro.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); playSequence(); } });

/* Init */
buildGarden();
